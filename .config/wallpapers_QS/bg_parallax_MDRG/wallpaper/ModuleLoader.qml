import QtQuick

// Обгортка модуля: вмикається/вимикається через isOn (settings.json -> <модуль>.enabled).
// Вимкнений модуль не створюється взагалі (cava та інші процеси теж не запускаються).
// Repeater кладе створений модуль прямо в Parallax (свого батька), а не в проміжний Loader,
// тому розмір, позиція та z модуля лишаються своїми і він стоїть між шарами паралакса.
Repeater {
    property bool isOn: true

    model: isOn ? 1 : 0
}
