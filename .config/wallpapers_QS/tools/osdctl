#!/bin/sh
# osdctl — клавіші гучності / мікрофона / яскравості / підсвітки клавіатури + спливаюче віконце (bg_osd)
#   osdctl volume up|down|mute   osdctl mic mute   osdctl brightness up|down   osdctl kbd up|down|cycle
OSD="qs -p $HOME/.config/wallpapers_QS/bg_osd/shell.qml ipc call osd"
case "$1" in
  volume)
    case "$2" in
      up)   wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ ;;
      down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
      mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    esac
    v=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
    p=$(echo "$v" | awk '{printf "%d", $2*100+0.5}'); m=0; echo "$v" | grep -q MUTED && m=1
    $OSD level volume "$p" "$m"
    [ "$m" = 0 ] && "$HOME/.config/wallpapers_QS/tools/sfx" volume ;;   # «тук» на новій гучності, як у KDE
  mic)
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
    v=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@)
    p=$(echo "$v" | awk '{printf "%d", $2*100+0.5}'); m=0; echo "$v" | grep -q MUTED && m=1
    $OSD level mic "$p" "$m" ;;
  brightness)
    case "$2" in
      up)   brightnessctl -e4 -n2 -q set 5%+ ;;
      down) brightnessctl -e4 -n2 -q set 5%- ;;
    esac
    p=$(brightnessctl -m | awk -F, '{gsub("%","",$4); print $4}')
    $OSD level brightness "$p" 0 ;;
  kbd)
    d=$(ls -d /sys/class/leds/*kbd_backlight* 2>/dev/null | head -n1); [ -n "$d" ] || exit 0
    dev=$(basename "$d"); max=$(cat "$d/max_brightness"); cur=$(cat "$d/brightness")
    case "$2" in
      up)    n=$((cur + 1)); [ $n -gt $max ] && n=$max ;;
      down)  n=$((cur - 1)); [ $n -lt 0 ] && n=0 ;;
      cycle) n=$(( (cur + 1) % (max + 1) )) ;;
      *)     n=$2 ;;
    esac
    brightnessctl -q -d "$dev" set "$n" ;;   # віконце покаже сам bg_osd (він стежить за підсвіткою)
esac
