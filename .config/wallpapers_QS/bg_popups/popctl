        return act(r == 0, e)
    if c == "audio-mute":               # audio-mute sink|source|app ID
        kind = {"sink": "sink", "source": "source", "app": "sink-input"}[a[1]]
        r, o, e = run(["pactl", f"set-{kind}-mute", a[2], "toggle"])
        return act(r == 0, e)
    if c == "net-profile":              # net-profile up|down NAME
        r, o, e = run(["nmcli", "connection", a[1], a[2]], timeout=20)
