{
  "cpu": {
    "format": " {usage}%  ",
    "on-click": "kitty -e htop"
  },

  "memory": {
    "format": "  {}%  ",
    "on-click": "kitty -e htop"
  },

  "disk": {
    "interval": 30,
    "format": "D {percentage_used}%  ",
    "path": "/",
    "on-click": "kitty -e htop"
  },

  "temperature": {
    "format": "{icon} {temperatureC}°C  ",
    "format-icons": ["", "", ""],
    "interval": 1,
    "critical-threshold": 80,
    // Датчик процесора Intel (coretemp). Номер hwmonN змінюється між перезавантаженнями,
    // тому вказується папка БЕЗ hwmonN — waybar знайде його сам.
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input"
  },

  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󱊦  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-full": "󰁹 {capacity}%",
    "format-alt": "{icon}  {time}",
    "format-icons": [" ", " ", " ", " ", " "]
  },

  "group/hardware": {
    "orientation": "horizontal",
    "modules": ["cpu", "memory", "disk", "temperature", "battery"]
  }
}
