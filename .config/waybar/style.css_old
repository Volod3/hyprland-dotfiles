@define-color base alpha(#000000, 0.1);
@define-color surface alpha(#181825, 0.5);
@define-color text #cdd6f4;
@define-color hoverBg alpha(@mauve, 1);
@define-color hoverFg #000000;
@define-color activeBg alpha(@mauve, 1);
@define-color activeFg #000000;
@define-color shadow alpha(@lavender, 0.25);




* {
  all: unset;
  font-size: 1rem;
  font-weight: 900;
  font-family:
    JetBrainsMonoNerdFont,
    Font Awesome,
    Roboto,
    Helvetica,
    Arial,
    sans-serif;
  background-clip: border-box;
}

button {
  min-width: 32px;
  min-height: 32px;
  border-radius: 999px;
  color: @text;
  box-shadow: 0px 0px 8px 4px @shadow inset;
  transition:
    all 50ms cubic-bezier(0.55, 0, 0.28, 1.682),
    box-shadow 50ms ease-in-out,
    background-color 200ms ease-in-out;
}

button:hover {
  color: @hoverFg;
  background: @hoverBg;
}

button.active {
  color: @activeFg;
  background: @activeBg;
}

tooltip {
  opacity: 1;
}




tooltip {
  opacity: 1;
  background-color: alpha(#181825, 0.9);
  border: 1px solid @mauve;
  border-radius: 12px;
  padding: 6px;
  box-shadow: 0px 0px 12px 4px @shadow;
}

tooltip label {
  color: @text;
  padding: 4px 8px;
}


menu {
  background-color: alpha(#181825, 0.9);
  border: 1px solid @mauve;
  border-radius: 12px;
  padding: 6px;
  box-shadow: 0px 0px 12px 4px @shadow;
}

menuitem {
  color: @text;
  border-radius: 8px;
  padding: 6px 10px;
  min-height: 20px;
}

menuitem:hover {
  background-color: @hoverBg;
  color: @hoverFg;
}

menuitem separator,
separator {
  background-color: alpha(@text, 0.15);
  min-height: 1px;
  margin: 4px 6px;
}



window#waybar.empty #window {
  background-color: transparent;
}

#window {
  margin-right: 8px;
}

#workspaces,
#custom-appmenu,
#quicklinks,
#media,
#hardware,
#brightness,
#clock,
#language,
#bluetooth,
#network,
#tray,
#custom-notification {
  background-color: @surface;
  background-clip: padding-box;
  border-style: solid;
  border-width: 0 20px 0 20px;
  border-image: url("shape.svg") 0 20 0 20 stretch;
  border-radius: 0;
  box-shadow: none;
}

#brightness {
  padding: 0 14px;
}

#backlight-slider slider {
  min-height: 0;
  min-width: 0;
  opacity: 0;
  background: none;
  border: none;
  box-shadow: none;
}

#backlight-slider trough {
  min-width: 8px;
  min-height: 24px;
  border-radius: 999px;
  background-color: alpha(@text, 0.15);
}

#backlight-slider highlight {
  min-width: 8px;
  border-radius: 999px;
  background-color: @mauve;
}



#media,
#hardware,
#clock {
  padding: 0 14px;
}

#custom-quicklink1,
#custom-quicklink2,
#custom-quicklink3,
#custom-quicklink4,
#custom-quicklink5,
#custom-quicklink6,
#custom-quicklink7,
#custom-quicklink8,
#custom-quicklink9,
#custom-quicklink10 {
  font-size: 1.5rem;
  margin: 0 0.5rem;
}
#custom-quicklink1 {
  /* margin-left: 0; */
}

#cpu,
#memory,
#disk {
  padding-right: 0.5rem;
}

#custom-appmenu,
#custom-notification {
  font-size: 24px;
  min-width: 32px;
  min-height: 32px;
  padding: 0 10px;
  /*border-radius: 14px 14px 24px 24px;*/
}

#workspaces {
  padding: 0 6px;
}

#workspaces button {
  min-width: 26px;
  min-height: 32px;
  margin: 0 1px;
  padding: 0 4px;
  border-radius: 0;
  box-shadow: none;
  background: none;
  color: alpha(@text, 0.4);
  border-bottom: 3px solid transparent;
}


#workspaces button:hover {
  color: @mauve;
  background: alpha(@mauve, 0.15);
  border-bottom-color: alpha(@mauve, 0.6);
}

#workspaces button.active {
  color: @mauve;
  background: linear-gradient(to top, alpha(@mauve, 0.3), transparent);
  border-bottom-color: @mauve;
}

#workspaces button.urgent {
  color: @red;
  border-bottom-color: @red;
}



#taskbar {
  font-weight: normal;
  font-style: normal;
}

@keyframes blink {
  to {
    background-color: @activeBg;
  }
}

#battery.critical:not(.charging) {
  background-color: @activeBg;
  animation-name: blink;
  animation-duration: 0.5s;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
  animation-direction: alternate;
}

#tray > .passive {
  -gtk-icon-effect: dim;
}

#tray > .needs-attention {
  -gtk-icon-effect: highlight;
  background-color: @activeBg;
}

label:focus {
  background-color: @activeBg;
}

#backlight {
  margin-right: 8px;
  background: none;
}

#quicklinks {
}

#temperature.critical {
  color: red;
}
