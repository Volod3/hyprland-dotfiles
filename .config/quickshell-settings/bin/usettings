def cmd_layouts():
    """Усі розкладки XKB (код + назва); популярні — першими й українською."""
    out = []
    try:
        txt = open("/usr/share/X11/xkb/rules/evdev.lst", encoding="utf-8").read()
        sec = txt.split("! layout", 1)[1].split("!", 1)[0]
        for line in sec.strip().splitlines():
            code, _, desc = line.strip().partition(" ")
            out.append({"code": code, "name": UK_NAMES.get(code, desc.strip())})
    except (OSError, IndexError):
        out = [{"code": k, "name": v} for k, v in UK_NAMES.items()]
    pop = [c for c in UK_NAMES]
    out.sort(key=lambda x: (pop.index(x["code"]) if x["code"] in pop else 999, x["name"].lower()))
    print(json.dumps(out, ensure_ascii=False))


def cmd_startup():
    d = load()
    if d.get("cursor.theme"):
        apply_cursor(d)
    write_idle(d)
    restart_idle()
    night(d)


def main():
    a = sys.argv[1:]
    if not a or a[0] == "get":
        return cmd_get()
    if a[0] == "set" and len(a) >= 3:
        return cmd_set(a[1], a[2])
    if a[0] == "startup":
        return cmd_startup()
    if a[0] == "layouts":
        return cmd_layouts()
    if a[0] == "cursors":
        return cmd_cursors()
    if a[0] == "monitors":
        return cmd_monitors()
    if a[0] == "display" and len(a) >= 3:
        return cmd_display(a[1], a[2])
    if a[0] == "regen":              # перегенерувати user-settings.lua (після змін на сторінці «Оформлення»)
        return write_lua(load())
    if a[0] == "lid" and len(a) >= 2:
        return cmd_lid(a[1])
    print(__doc__)


if __name__ == "__main__":
    main()
