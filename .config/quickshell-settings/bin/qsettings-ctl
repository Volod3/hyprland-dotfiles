# скрипти theme-switch: шлях довгий, тому шукаємо за іменем файлу
SCRIPT_RULES = [
    ("theme-menu", "Меню вибору теми", "theme"),
    ("game-mode", "Ігровий режим: увімкнути / вимкнути", "theme"),
    ("hypr-settings", "Налаштування Hyprland", "theme"),
