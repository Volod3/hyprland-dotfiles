def describe_cmd(cmd):
    c = cmd.strip()
    if re.search(r"theme-switch\s+toggle", c):
        return "Перемкнути тему (Мадара ⇄ Азур)", "theme"
    if re.search(r"(^|/)theme-switch(\s|$)", c):
        return "Застосувати поточну тему", "theme"
    for name, label, group in SCRIPT_RULES:
        if re.search(r"(^|/)" + re.escape(name) + r"(\s|$)", c):
            return label, group
    for pattern, label, group in CMD_RULES:
        if re.search(pattern, c):
            return label, group
    short = c if len(c) <= 46 else c[:43] + "…"
    return "Команда: " + short, "apps"


def describe_action(expr, aliases, varz):
    expr = expr.strip()
    if not expr.startswith("hl.dsp."):
        return "Невідома дія", "apps", expr
    name, arg_src = split_call(expr[len("hl.dsp."):])
    arg = arg_src
    if arg_src.startswith("{"):
        arg = parse_lua_table(arg_src, aliases, varz)
    elif arg_src:
        arg = eval_expr(arg_src, aliases, varz)

    if name == "exec_cmd":
        label, group = describe_cmd(str(arg))
        return label, group, {"exec": str(arg)}
    if name == "window.close":
        return "Закрити активне вікно", "windows", {}
    if name == "window.float":
        return "Плаваюче вікно: увімкнути / вимкнути", "windows", {}
    if name == "window.pseudo":
        return "Псевдотайлінг: увімкнути / вимкнути", "windows", {}
    if name == "window.fullscreen":
        return "Повноекранний режим", "windows", {}
    if name == "window.drag":
        return "Перетягнути вікно", "mouse", {}
    if name == "window.resize":
        if isinstance(arg, dict) and arg.get("relative"):
            dx, dy = arg.get("x", 0), arg.get("y", 0)
            if dx:
                return ("Ширина вікна %+d px" % dx), "windows", {}
            if dy:
                return ("Висота вікна %+d px" % dy), "windows", {}
        return "Змінити розмір вікна", "mouse", {}
    if name == "window.move" and isinstance(arg, dict):
        ws = arg.get("workspace")
        if isinstance(ws, str) and ws.startswith("special:"):
            return "Вікно → прихований стіл «%s»" % ws.split(":", 1)[1], "workspaces", {}
        return "Вікно → робочий стіл %s" % ws, "workspaces", {}
    if name == "workspace.toggle_special":
        return "Показати / сховати стіл «%s»" % arg, "workspaces", {}
    if name == "focus":
        if isinstance(arg, dict):
            if "direction" in arg:
                d = str(arg["direction"])
                return "Фокус %s" % DIRS.get(d, d), "focus", {}
            ws = str(arg.get("workspace", ""))
            if ws == "e+1":
                return "Наступний робочий стіл (колесо ↓)", "workspaces", {}
            if ws == "e-1":
                return "Попередній робочий стіл (колесо ↑)", "workspaces", {}
            return "Перейти на робочий стіл %s" % ws, "workspaces", {}
    if name == "layout":
        return "Dwindle: розділити / об'єднати", "windows", {}
    return "Дія: %s" % name, "apps", {}


def pretty_combo(combo):
    parts = [p.strip() for p in combo.split("+")]
    out = []
    for part in parts:
        out.append(KEY_LABELS.get(part, part))
    return " + ".join(out)


def find_bind_calls(lines):
    """Повертає список (line_no, text) для кожного hl.bind(...)."""
    calls, i = [], 0
    while i < len(lines):
        line = strip_comment(lines[i])
        if "hl.bind(" not in line:
            i += 1
            continue
        start = i
        text = line.strip()
        while text.count("(") > text.count(")") and i + 1 < len(lines):
            i += 1
            text += " " + strip_comment(lines[i]).strip()
        calls.append((start + 1, text))
        i += 1
    return calls


def collect_aliases(lines):
    aliases = {}
    for raw in lines:
        line = strip_comment(raw)
        m = re.match(r'^\s*local\s+([A-Za-z_]\w*)\s*=\s*("(?:[^"\\]|\\.)*")\s*$', line)
        if m:
            try:
                aliases[m.group(1)] = ast.literal_eval(m.group(2))
            except Exception:
                pass
    return aliases


def expand_loops(lines):
    """Розгортає `for i = 1, 10 do ... end` у (line, vars) пари."""
    out = []
    stack = [({}, False)]
    loop = None
    for idx, raw in enumerate(lines):
        line = strip_comment(raw)
        stripped = line.strip()
        m = re.match(r'^for\s+([A-Za-z_]\w*)\s*=\s*(-?\d+)\s*,\s*(-?\d+)\s*(?:,\s*(-?\d+))?\s+do\b', stripped)
        if m and loop is None:
            loop = {"var": m.group(1), "from": int(m.group(2)),
                    "to": int(m.group(3)), "step": int(m.group(4) or 1),
                    "body": []}
            continue
        if loop is not None:
            if re.match(r"^end\b", stripped):
                for value in range(loop["from"], loop["to"] + 1, loop["step"]):
                    varz = {loop["var"]: value}
                    out.extend([(ln, txt, varz) for ln, txt in loop["body"]])
                loop = None
            else:
                loop["body"].append((idx + 1, raw))
            continue
        out.append((idx + 1, raw, {}))
    return out


def cmd_binds():
    if not HYPR_LUA.exists():
        emit({"ok": False, "error": "немає %s" % HYPR_LUA}, 2)
    lines = HYPR_LUA.read_text(encoding="utf-8", errors="replace").splitlines()
    aliases = collect_aliases(lines)
    expanded = expand_loops(lines)

    items = []
    prev_varz = None
    local_vars = {}
    for lineno, text, varz in expanded:
        clean = strip_comment(text)
        if varz != prev_varz:
            local_vars = dict(varz)
            prev_varz = varz
        # локальні змінні всередині циклу: local key = i % 10
        mm = re.match(r'^\s*local\s+([A-Za-z_]\w*)\s*=\s*(.+)$', clean)
        if mm and "hl.bind(" not in clean:
            name, src = mm.group(1), mm.group(2).strip()
            if src.startswith('"'):
                try:
                    local_vars[name] = ast.literal_eval(src)
                except Exception:
                    pass
            elif any(ch.isdigit() or ch in "i%-+* " for ch in src):
                try:
                    local_vars[name] = eval(src, {"__builtins__": {}},
                                            {**aliases, **local_vars})  # noqa: S307
                except Exception:
                    pass
            continue
        if "hl.bind(" not in clean:
            continue
        body = clean[clean.find("hl.bind(") + len("hl.bind("):]
        body = body.rsplit(")", 1)[0]
        args = split_top(body, ",")
        if len(args) < 2:
            continue
        scope = {**local_vars, **varz}
        combo = pretty_combo(str(eval_expr(args[0], aliases, scope)))
        action, group, detail = describe_action(args[1], aliases, scope)
        opts = args[2] if len(args) > 2 else ""
        if "long_press" in opts:
            action += " · довге натискання"
        items.append({
            "combo": combo, "action": action, "group": group,
            "detail": detail, "mouse": "mouse" in opts,
            "line": lineno,
        })

    groups = {}
    for item in items:
        groups.setdefault(item["group"], []).append(item)
    ordered = []
    for gid, label in GROUP_ORDER:
        if gid in groups:
            ordered.append({"id": gid, "name": label, "items": groups.pop(gid)})
    for gid, rest in groups.items():
        ordered.append({"id": gid, "name": gid, "items": rest})

    payload = {
        "ok": True,
        "source": str(HYPR_LUA),
        "generated_at": now_iso(),
        "count": len(items),
        "groups": ordered,
        "items": items,
    }
    write_json(CACHE / "binds.json", payload)
    emit(payload)


# ------------------------------------------------------------------ state ----
def theme_info(theme_id):
    label, accent, icon = theme_id, "#7fdcff", ""
    conf = BASE / "themes"
    for d in sorted(conf.glob("*/theme.conf")):
        txt = d.read_text(encoding="utf-8", errors="replace")
        mid = re.search(r'^ID="?([^"\n]+)"?', txt, re.M)
        if mid and mid.group(1).strip() == theme_id:
            ml = re.search(r'^LABEL="?([^"\n]+)"?', txt, re.M)
            ma = re.search(r'^MENU_ACCENT="?([^"\n]+)"?', txt, re.M)
            mi = re.search(r'^ICON="?([^"\n]+)"?', txt, re.M)
            label = ml.group(1).strip() if ml else theme_id
            accent = ma.group(1).strip() if ma else accent
            icon = mi.group(1).strip() if mi else ""
            break
    return {"id": theme_id, "label": label, "accent": accent, "icon": icon}


# ігровий режим тепер — ~/.config/wallpapers_QS/tools/gamemode (старий theme-switch/bin/game-mode
# вбивав усі процеси Quickshell, тобто й бокову панель, пета, вікна waybar)
GAMEMODE = Path.home() / ".config/wallpapers_QS/tools/gamemode"
GAME_STATE = Path.home() / ".cache/gamemode.json"


def game_active():
    try:
        return json.loads(GAME_STATE.read_text()).get("active") is True
    except Exception:
        return False


def themes_list():
    out = []
    for d in sorted((BASE / "themes").glob("*/theme.conf")):
        txt = d.read_text(encoding="utf-8", errors="replace")
        info = {"id": "", "label": d.parent.name, "accent": "#7fdcff", "icon": ""}
        for key, field in (("ID", "id"), ("LABEL", "label"),
                           ("MENU_ACCENT", "accent"), ("ICON", "icon")):
            m = re.search(r'^%s="?([^"\n]+)"?' % key, txt, re.M)
            if m:
                info[field] = m.group(1).strip()
        if info["id"]:
            out.append(info)
    return out


def current_theme():
    # старі теми theme-switch (Мадара/Азур) більше не використовуються — одна тема «небо й хмари»
    return "sky"


def cmd_state():
    tid = current_theme()
    info = theme_info(tid)
    wallpaper = ""
    for conf in (BASE / "themes").glob("*/theme.conf"):
        txt = conf.read_text(encoding="utf-8", errors="replace")
        mid = re.search(r'^ID="?([^"\n]+)"?', txt, re.M)
        if mid and mid.group(1).strip() == tid:
            m = re.search(r'^QS_DIR="?([^"\n]+)"?', txt, re.M)
            if m:
                wallpaper = os.path.basename(m.group(1).strip())
            break
    emit({
        "ok": True,
        "theme": info,
        "themes": themes_list(),
        "game_on": game_active(),
        "game_state_file": str(GAME_STATE),
        "wallpaper": wallpaper,
        "updated": now_iso(),
    })


def cmd_sysinfo():
    def read(path):
        try:
            return Path(path).read_text(encoding="utf-8", errors="replace")
        except Exception:
            return ""

    model = " ".join(x for x in [
        read("/sys/devices/virtual/dmi/id/sys_vendor").strip(),
        read("/sys/devices/virtual/dmi/id/product_name").strip()] if x) or "невідомо"

    cpu = "невідомо"
    for line in read("/proc/cpuinfo").splitlines():
        if line.lower().startswith("model name"):
            cpu = line.split(":", 1)[1].strip()
            break
    cores = sum(1 for l in read("/proc/cpuinfo").splitlines()
                if l.startswith("processor"))

    gpus = []
    if shutil.which("lspci"):
        try:
            out = subprocess.run(["lspci"], capture_output=True, text=True,
                                 timeout=8).stdout
            for line in out.splitlines():
                if re.search(r"VGA compatible|3D controller|Display controller", line):
                    g = line.split(": ", 1)[-1]
                    g = re.sub(r"\[[0-9a-f]{4}\]\s*", "", g)
                    gpus.append(g.strip())
        except Exception:
            pass
    if not gpus:
        gpus = ["невідомо"]

    mem_total = mem_avail = 0
    for line in read("/proc/meminfo").splitlines():
        if line.startswith("MemTotal:"):
            mem_total = int(line.split()[1])
        elif line.startswith("MemAvailable:"):
            mem_avail = int(line.split()[1])
    gib = 1024 * 1024

    hypr = ""
    p = hyprctl("version")
    if p and p.stdout:
        first = p.stdout.splitlines()[0]
        m = re.match(r"(Hyprland\s+[\d.]+)", first)
        hypr = m.group(1) if m else first.strip()
    if not hypr:
        hypr = "Hyprland (немає IPC)"

    monitors = []
    p = hyprctl("monitors", "-j")
    if p and p.stdout:
        try:
            for m in json.loads(p.stdout):
                monitors.append("%s %dx%d@%.0f" % (m.get("name"), m.get("width"),
                                                   m.get("height"),
                                                   float(m.get("refreshRate", 0))))
        except Exception:
            pass

    emit({
        "ok": True,
        "model": model,
        "cpu": cpu,
        "cores": cores,
        "gpu": " · ".join(gpus),
        "ram_total_gib": round(mem_total / gib, 1),
        "ram_used_gib": round((mem_total - mem_avail) / gib, 1),
        "ram_percent": int(round((mem_total - mem_avail) * 100 / mem_total)) if mem_total else 0,
        "hyprland": hypr,
        "kernel": os.uname().release,
        "monitors": monitors,
        "session": os.environ.get("XDG_CURRENT_DESKTOP", "Hyprland"),
        "updated": now_iso(),
    })


# ------------------------------------------------------------ actions --------
def run_script(cmd, timeout=90):
    env = os.environ.copy()
    log("run: %s" % " ".join(cmd))
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout,
                           env=env)
        return p.returncode, (p.stdout or "") + (p.stderr or "")
    except Exception as exc:
        return 1, str(exc)


def theme_info(theme_id):  # noqa: F811 — перекриває стару версію
    return {"id": "sky", "label": "Небо й хмари · синя", "accent": "#6fa8ff", "icon": ""}


def themes_list():  # noqa: F811
    return [theme_info("sky")]


def cmd_theme(arg):
    # перемикання старих тем вимкнено: theme-switch переписував конфіги під інші шпалери
    emit({"ok": False, "error": "Перемикання тем вимкнено — тема одна («Небо й хмари»). "
                                 "Кольори: ~/.config/waybar/style.css, bg_sidepanel/sidepanel.json"}, 0)
    script = str(BASE / "bin" / "theme-switch")
    if arg == "current":
        emit({"ok": True, "theme": theme_info(current_theme())})
    if arg == "toggle":
        cmd = [script, "toggle"]
    elif arg in ("1", "2", "madara", "azure"):
        cmd = [script, "apply", arg]
    else:
        emit({"ok": False, "error": "usage: theme apply 1|2 | theme toggle"}, 2)
    rc, out = run_script(cmd, timeout=120)
    emit({"ok": rc == 0, "rc": rc, "output": out.strip()[-800:],
          "theme": theme_info(current_theme())})


def cmd_game(arg):
    script = str(GAMEMODE)
    if arg == "status":
        emit({"ok": True, "game_on": game_active()})
    rc, out = run_script([script, "toggle"], timeout=90)
    emit({"ok": rc == 0, "rc": rc, "game_on": game_active(),
          "output": out.strip()[-600:]})


def cmd_wallpaper():
    """Перезапустити паралакс-шпалери (Quickshell)."""
    shell = str(Path.home() / ".config/wallpapers_QS/bg_parallax_MDRG/shell.qml")
    subprocess.run(["pkill", "-f", "^qs -p " + re.escape(shell) + "$"], capture_output=True)
    time.sleep(0.5)
    subprocess.Popen(["setsid", "-f", "qs", "-p", shell], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    emit({"ok": True, "rc": 0, "output": "Шпалери перезапущено", "theme": theme_info(current_theme())})


def focused_output():
    p = hyprctl("monitors", "-j")
    if p and p.stdout:
        try:
            for m in json.loads(p.stdout):
                if m.get("focused"):
                    return m.get("name")
        except Exception:
            pass
    return None


def grim_shot(path):
    if not shutil.which("grim"):
        return False
    out = focused_output()
    cmd = ["grim"] + (["-o", out] if out else []) + [path]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
        log("grim %s -> rc=%s %s" % (path, r.returncode, (r.stderr or "").strip()))
        return r.returncode == 0 and os.path.exists(path)
    except Exception as exc:
        log("grim failed: %s" % exc)
        return False


def cmd_shot():
    """spectacle у фоні; якщо він не віддав файл — той самий шлях через grim."""
    ts = datetime.now().strftime("%Y%m%d-%H%M%S")
    path = "/tmp/hypr-settings-%s.png" % ts
    if os.path.exists(path):
        os.unlink(path)
    method = None
    proc = None
    if shutil.which("spectacle"):
        try:
            proc = subprocess.Popen(["spectacle", "-f", "-b", "-n", "-o", path],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                    start_new_session=True)
        except Exception as exc:
            log("spectacle launch failed: %s" % exc)
            proc = None
        deadline = time.time() + 6
        while time.time() < deadline:
            if os.path.exists(path) and os.path.getsize(path) > 1024:
                method = "spectacle"
                break
            if proc.poll() is not None:
                break
            time.sleep(0.25)
        if method is None and proc.poll() is None:
            try:
                proc.terminate()
            except Exception:
                pass

    if method is None and grim_shot(path):
        method = "grim"

    ok = method is not None and os.path.exists(path) and os.path.getsize(path) > 1024
    write_json(CACHE / "last-shot.json", {"path": path, "ok": ok, "method": method,
                                          "at": now_iso()})
    emit({"ok": ok, "path": path if ok else "", "method": method,
          "error": None if ok else "ні spectacle, ні grim не віддали файл"})


# ------------------------------------------------------------------- main ----
def main(argv):
    detect_env()
    cmd = argv[1] if len(argv) > 1 else "opts"
    args = argv[2:]
    if cmd == "opts":
        cmd_opts()
    elif cmd == "set":
        if len(args) < 2:
            emit({"ok": False, "error": "usage: set <key> <value>"}, 2)
        cmd_set(args[0], args[1])
    elif cmd == "apply":
        cmd_apply(args[0] if args else "{}")
    elif cmd == "reset":
        cmd_reset()
    elif cmd == "restore":
        cmd_restore()
    elif cmd == "binds":
        cmd_binds()
    elif cmd == "state":
        cmd_state()
    elif cmd == "sysinfo":
        cmd_sysinfo()
    elif cmd == "theme":
        cmd_theme(args[0] if args else "current")
    elif cmd == "game":
        cmd_game(args[0] if args else "status")
    elif cmd == "wallpaper":
        cmd_wallpaper()
    elif cmd == "shot":
        cmd_shot()
    else:
        emit({"ok": False, "error": "unknown command: %s" % cmd}, 2)


if __name__ == "__main__":
    main(sys.argv)
