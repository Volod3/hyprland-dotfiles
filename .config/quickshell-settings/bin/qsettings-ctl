#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""qsettings-ctl — бекенд Quickshell-застосунку налаштувань Hyprland.

Підкоманди (усі друкують один рядок JSON у stdout):
  opts                     поточні значення опцій оформлення + defaults + overrides
  set <key> <value>        застосувати одну опцію, перевірити getoption, зберегти
  apply '<json-map>'       застосувати набір опцій (кнопка «Застосувати»)
  reset                    повернути типові значення теми (кнопка «Скинути до теми»)
  restore                  повернути значення з overrides.json
  binds                    розібрати ~/.config/hypr/hyprland.lua -> cache/binds.json
  state                    тема, ігровий режим, шпалери
  sysinfo                  залізо + версії
  theme apply <1|2>|toggle|current
  game toggle|status
  wallpaper                theme-switch apply <current>
  shot                     spectacle -f -b -n -o /tmp/...

Hyprland 0.57 з Lua-конфігом: `hyprctl keyword` майже завжди відповідає
«unknown request», тому кожна опція ставиться через
`hyprctl eval 'hl.config({...})'` і потім звіряється з `hyprctl getoption`.
Файл hyprland.lua лише читається — жодних записів.
"""
import ast
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone, timedelta
from pathlib import Path

APP = Path(__file__).resolve().parent.parent
CACHE = APP / "cache"
DEFAULTS_FILE = APP / "defaults.json"
OVERRIDES_FILE = APP / "overrides.json"
BASE = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "theme-switch"
LOG_FILE = BASE / "logs" / "hypr-settings.log"
HYPR_LUA = Path.home() / ".config" / "hypr" / "hyprland.lua"

OPTS = [
    "general:gaps_in", "general:gaps_out", "general:border_size",
    "decoration:rounding", "decoration:active_opacity", "decoration:inactive_opacity",
    "decoration:blur:enabled", "decoration:blur:size", "decoration:blur:passes",
    "decoration:blur:vibrancy", "animations:enabled",
]

TZ = timezone(timedelta(hours=2))  # EET


# ---------------------------------------------------------------- helpers ----
def log(msg):
    try:
        LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
        with LOG_FILE.open("a", encoding="utf-8") as fh:
            fh.write("%s [ctl:%s] %s\n" % (
                datetime.now().strftime("%F %T"), os.getpid(), msg))
    except Exception:
        pass


def emit(obj, code=0):
    print(json.dumps(obj, ensure_ascii=False))
    sys.exit(code)


def now_iso():
    return datetime.now(TZ).isoformat(timespec="seconds")


def load_json(path, fallback):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:
        return fallback


def write_json(path, obj):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(obj, fh, ensure_ascii=False, indent=2)
        fh.write("\n")
    os.replace(tmp, path)


# ------------------------------------------------------------------- env -----
def detect_env():
    rt = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
    os.environ["XDG_RUNTIME_DIR"] = rt
    if not os.environ.get("WAYLAND_DISPLAY"):
        for cand in sorted(glob.glob(rt + "/wayland-*")):
            if cand.endswith(".lock"):
                continue
            if os.path.exists(cand):
                os.environ["WAYLAND_DISPLAY"] = os.path.basename(cand)
                break
    sigs = []
    env_sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if env_sig:
        sigs.append(env_sig)
    for d in sorted(glob.glob(rt + "/hypr/*/")):
        s = os.path.basename(d.rstrip("/"))
        if s not in sigs:
            sigs.append(s)
    for sig in sigs:
        if not (Path(rt) / "hypr" / sig / ".socket.sock").exists():
            continue
        env = dict(os.environ, HYPRLAND_INSTANCE_SIGNATURE=sig)
        try:
            p = subprocess.run(["hyprctl", "monitors", "-j"], env=env,
                               capture_output=True, text=True, timeout=8)
        except Exception:
            continue
        if p.returncode == 0 and p.stdout.strip().startswith("["):
            os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = sig
            return sig
    return os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")


def hyprctl(*args, timeout=10):
    try:
        return subprocess.run(["hyprctl", *args], capture_output=True,
                              text=True, timeout=timeout)
    except Exception as exc:
        log("hyprctl %s failed: %s" % (" ".join(args[:2]), exc))
        return None


NUM_RE = re.compile(r"-?\d+(?:\.\d+)?")


def parse_option(text):
    """Розбирає вивід `hyprctl getoption` у типізоване значення."""
    for raw in (text or "").splitlines():
        line = raw.strip()
        if not line:
            continue
        if line.startswith("css gap data:"):
            m = NUM_RE.search(line.split(":", 1)[1])
            return int(float(m.group())) if m else None
        m = re.match(r"^(int|float|bool|str|color|vec2):\s*(.*)$", line)
        if not m:
            continue
        kind, val = m.group(1), m.group(2).strip()
        if kind == "int":
            try:
                return int(val)
            except ValueError:
                return None
        if kind == "float":
            try:
                return float(val)
            except ValueError:
                return None
        if kind == "bool":
            return val == "true"
        return val
    return None


def get_option(name):
    p = hyprctl("getoption", name)
    if p is None or p.returncode != 0:
        return None
    return parse_option(p.stdout)


def lua_literal(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return repr(value)
    return '"%s"' % str(value).replace("\\", "\\\\").replace('"', '\\"')


def lua_config(path, value):
    parts = path.split(":")
    # найглибша таблиця: { leaf = value }, далі обгортаємо батьками
    lua = "{ %s = %s }" % (parts[-1], lua_literal(value))
    for seg in reversed(parts[:-1]):
        lua = "{ %s = %s }" % (seg, lua)
    return "hl.config(%s)" % lua


def same(a, b):
    if isinstance(a, bool) or isinstance(b, bool):
        return bool(a) == bool(b)
    if isinstance(a, (int, float)) and isinstance(b, (int, float)):
        return abs(float(a) - float(b)) < 0.005
    return str(a) == str(b)


def apply_one(key, value):
    lua = lua_config(key, value)
    p = hyprctl("eval", lua)
    ok = p is not None and "ok" in (p.stdout or "")
    got = get_option(key)
    verified = got is not None and same(got, value)
    res = {"ok": ok, "key": key, "value": value, "got": got,
           "verified": verified, "lua": lua}
    log("apply %s=%s -> ok=%s got=%s verified=%s"
        % (key, value, ok, got, verified))
    return res


def save_overrides(values):
    data = {"updated_at": now_iso(),
            "hyprland_sig": os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", ""),
            "values": {k: v for k, v in values.items() if k in OPTS}}
    write_json(OVERRIDES_FILE, data)
    # щоб зміни «Оформлення» пережили перезапуск — оновити user-settings.lua (його підключає hyprland.lua)
    try:
        subprocess.run([str(Path(__file__).resolve().parent / "usettings"), "regen"], timeout=10)
    except Exception as exc:
        log("regen failed: %s" % exc)
    return data


def coerce(raw, template):
    if isinstance(template, bool):
        return str(raw).strip().lower() in ("1", "true", "on", "yes")
    if isinstance(template, int):
        return int(round(float(raw)))
    if isinstance(template, float):
        return float(raw)
    return raw


# ---------------------------------------------------------------- options ----
def cmd_opts():
    values = {}
    for name in OPTS:
        values[name] = get_option(name)
    defaults = load_json(DEFAULTS_FILE, {})
    over = load_json(OVERRIDES_FILE, {}).get("values", {})
    emit({"ok": True, "values": values, "defaults": defaults,
          "overrides": over, "updated": now_iso()})


def cmd_set(key, raw):
    if key not in OPTS:
        emit({"ok": False, "error": "unknown option: %s" % key}, 2)
    defaults = load_json(DEFAULTS_FILE, {})
    value = coerce(raw, defaults.get(key))
    res = apply_one(key, value)
    if res["verified"] or res["got"] is not None:
        cur = load_json(OVERRIDES_FILE, {}).get("values", {})
        cur[key] = res["got"] if res["got"] is not None else value
        save_overrides(cur)
    emit(res)


def cmd_apply(map_json):
    try:
        wanted = json.loads(map_json)
    except Exception as exc:
        emit({"ok": False, "error": "bad json: %s" % exc}, 2)
    defaults = load_json(DEFAULTS_FILE, {})
    results = []
    applied = load_json(OVERRIDES_FILE, {}).get("values", {})
    for key, raw in wanted.items():
        if key not in OPTS:
            continue
        value = coerce(raw, defaults.get(key))
        res = apply_one(key, value)
        results.append(res)
        if res["got"] is not None:
            applied[key] = res["got"]
    save_overrides(applied)
    emit({"ok": all(r["verified"] for r in results), "results": results,
          "values": {r["key"]: r["got"] for r in results}})


def cmd_reset():
    defaults = load_json(DEFAULTS_FILE, {})
    if not defaults:
        emit({"ok": False, "error": "defaults.json відсутній"}, 2)
    results = []
    applied = {}
    for key in OPTS:
        if key not in defaults:
            continue
        res = apply_one(key, defaults[key])
        results.append(res)
        applied[key] = res["got"] if res["got"] is not None else defaults[key]
    save_overrides(applied)
    emit({"ok": all(r["verified"] for r in results), "results": results,
          "values": applied})


def cmd_restore():
    saved = load_json(OVERRIDES_FILE, {})
    values = saved.get("values", {})
    if not values:
        emit({"ok": False, "error": "overrides.json порожній"}, 2)
    results = []
    for key, value in values.items():
        if key in OPTS:
            results.append(apply_one(key, value))
    emit({"ok": all(r["verified"] for r in results), "results": results,
          "values": {r["key"]: r["got"] for r in results},
          "saved_at": saved.get("updated_at")})


# ------------------------------------------------------------- lua parser ----
def strip_comment(line):
    out, quote, i = [], None, 0
    while i < len(line):
        ch = line[i]
        if quote:
            out.append(ch)
            if ch == "\\" and i + 1 < len(line):
                out.append(line[i + 1])
                i += 1
            elif ch == quote:
                quote = None
        else:
            if ch in "\"'":
                quote = ch
                out.append(ch)
            elif line.startswith("--", i):
                break
            else:
                out.append(ch)
        i += 1
    return "".join(out)


def split_top(expr, sep):
    """Ділить вираз на top-level роздільнику (поза рядками/дужками)."""
    parts, buf, depth, quote, i = [], "", 0, None, 0
    while i < len(expr):
        ch = expr[i]
        if quote:
            buf += ch
            if ch == "\\" and i + 1 < len(expr):
                buf += expr[i + 1]
                i += 1
            elif ch == quote:
                quote = None
        elif ch in "\"'":
            quote = ch
            buf += ch
        elif ch in "({[":
            depth += 1
            buf += ch
        elif ch in ")}]":
            depth -= 1
            buf += ch
        elif depth == 0 and expr.startswith(sep, i):
            parts.append(buf.strip())
            buf = ""
            i += len(sep) - 1
        else:
            buf += ch
        i += 1
    parts.append(buf.strip())
    return parts


def eval_atom(atom, aliases, varz):
    atom = atom.strip()
    if not atom:
        return ""
    if atom[0] in "\"'":
        try:
            val = ast.literal_eval(atom)
            return "" if val is None else val
        except Exception:
            return atom.strip("\"'")
    if atom in aliases:
        return aliases[atom]
    if atom in varz:
        return varz[atom]
    try:
        return eval(atom, {"__builtins__": {}}, {**aliases, **varz})  # noqa: S307
    except Exception:
        return atom


def eval_expr(expr, aliases, varz):
    parts = split_top(expr.strip(), "..")
    if len(parts) == 1:
        return eval_atom(parts[0], aliases, varz)
    return "".join(str(eval_atom(p, aliases, varz)) for p in parts)


def split_call(expr):
    """'exec_cmd(foo)' -> ('exec_cmd', 'foo')"""
    idx = expr.find("(")
    if idx < 0:
        return expr.strip(), ""
    return expr[:idx].strip(), expr[idx + 1:].rstrip().rstrip(")").strip()


def parse_lua_table(text, aliases, varz):
    table = {}
    for m in re.finditer(
            r'([A-Za-z_]\w*)\s*=\s*("(?:[^"\\]|\\.)*"|true|false|-?\d+(?:\.\d+)?|[\w\.\-]+)',
            text):
        key, raw = m.group(1), m.group(2)
        if raw.startswith('"'):
            try:
                table[key] = ast.literal_eval(raw)
            except Exception:
                table[key] = raw.strip('"')
        elif raw in ("true", "false"):
            table[key] = raw == "true"
        elif re.fullmatch(r"-?\d+", raw):
            table[key] = int(raw)
        elif re.fullmatch(r"-?\d+\.\d+", raw):
            table[key] = float(raw)
        else:
            table[key] = eval_atom(raw, aliases, varz)
    return table


